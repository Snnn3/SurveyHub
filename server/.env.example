PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:replace-with-a-local-database-password@localhost:5432/surveyhub?schema=public"
DATABASE_URL_TEST="postgresql://postgres:replace-with-a-local-database-password@localhost:5432/surveyhub_test?schema=public"
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="8h"
CLIENT_ORIGIN="http://localhost:5173"
# DEMO_USER_PASSWORD is loaded from the root .env when running npm run db:seed.
