# Server Configuration
PORT=4000
NODE_ENV=development

# Compose PostgreSQL (replace the placeholder before starting Compose)
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_PORT=5432

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:replace-with-a-local-database-password@localhost:5432/surveyhub?schema=public"
DATABASE_URL_TEST="postgresql://postgres:replace-with-a-local-database-password@localhost:5432/surveyhub_test?schema=public"

# Authentication (JWT)
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="8h"
DEMO_USER_PASSWORD="replace-with-a-local-demo-password"

# Client Configuration
CLIENT_ORIGIN="http://localhost:5173"
VITE_API_BASE_URL="http://localhost:4000/api"
